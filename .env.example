# Exemple de configuration — copier en .env pour le développement local.
# Aucune valeur réelle ici. Rempli progressivement à mesure que le kernel (L0.5) et les modules
# d'identité (L0.6) sont implémentés. Voir docs/blueprint/12-devops-monitoring.md §1.

APP_ENV=development

# --- Base de données (docker compose local, voir infra/docker) ---
# Ports décalés : voir le commentaire en tête de infra/docker/compose.dev.yml.
DATABASE_URL=postgres://thy_app:changeme@localhost:5435/thy
MIGRATOR_DATABASE_URL=postgres://thy_migrator:changeme@localhost:5435/thy

# --- Redis ---
REDIS_URL=redis://localhost:6381

# --- Stockage objet (S3 local, RustFS) — voir backend/.env.example pour la liste complète ---
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9002
S3_BUCKET=thy-dev
S3_ACCESS_KEY_ID=thy_s3
S3_SECRET_ACCESS_KEY=changeme123

# --- Auth ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=thy-dev

# --- SMS / OTP (sandbox uniquement en dev) ---
SMS_PROVIDER_PRIMARY=sandbox
SMS_PROVIDER_FALLBACK=sandbox

# --- Observabilité ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
