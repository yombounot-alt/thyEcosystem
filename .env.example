# Exemple de configuration — copier en .env pour le développement local.
# Aucune valeur réelle ici. Rempli progressivement à mesure que le kernel (L0.5) et les modules
# d'identité (L0.6) sont implémentés. Voir docs/blueprint/12-devops-monitoring.md §1.

APP_ENV=development

# --- Base de données (docker compose local, voir infra/docker) ---
DATABASE_URL=postgres://thy_app:changeme@localhost:5432/thy

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Stockage objet (MinIO local) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=thy-dev
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- Auth ---
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=thy-dev

# --- SMS / OTP (sandbox uniquement en dev) ---
SMS_PROVIDER_PRIMARY=sandbox
SMS_PROVIDER_FALLBACK=sandbox

# --- Observabilité ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
