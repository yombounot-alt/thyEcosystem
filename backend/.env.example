# Copier en .env pour le développement local (voir infra/docker/compose.dev.yml pour les services).
# Ports décalés (5435/6381/3300) : ce poste fait tourner plusieurs autres projets THY sur les
# ports par défaut (voir le commentaire en tête de infra/docker/compose.dev.yml).
NODE_ENV=development
PORT=3300
TRUST_PROXY=false
CORS_ORIGINS=

DATABASE_URL=postgres://thy_app:changeme@localhost:5435/thy
MIGRATOR_DATABASE_URL=postgres://thy_migrator:changeme@localhost:5435/thy
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6381

JWT_SECRET=
JWT_ISSUER=thy-ecosystem
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30

HMAC_PEPPER=
DEFAULT_COUNTRY=GN
DEFAULT_CURRENCY=GNF

SMS_DRIVER=console
RATE_LIMIT_ENABLED=true

# Stockage des fichiers (photos produits, logos, preuves de paiement) : `local` (disque, dev/tests) ou
# `s3` (MinIO en local, Cloud Storage via son interop S3 en staging/production — ADR-012). La production
# refuse `local`. Pour essayer S3 en local : STORAGE_DRIVER=s3 avec les valeurs MinIO ci-dessous (bucket
# créé par le service `minio-init` de infra/docker/compose.dev.yml).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=http://localhost:9002
S3_REGION=auto
S3_BUCKET=thy-dev
S3_ACCESS_KEY_ID=thy_minio
S3_SECRET_ACCESS_KEY=changeme123
S3_FORCE_PATH_STYLE=true

# Code OTP constant pour le développement local et les tests mobile (6 chiffres) : aucun SMS n est envoyé
# avec SMS_DRIVER=console. Refusé en production. Laisser vide pour des codes aléatoires (lus dans les logs).
DEV_FIXED_OTP=

# Contrat OpenAPI servi sur /api/v1/openapi.json (défaut : activé hors production, désactivé en production).
OPENAPI_ENABLED=

# Observabilité — rien n'est envoyé tant que ces variables sont vides.
# Erreurs serveur (5xx) et événements en file des morts → Sentry (aucune donnée personnelle, voir
# src/kernel/observability/scrub.ts).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Version déployée (SHA de l'image) ; sur Cloud Run, K_REVISION est utilisé à défaut.
APP_RELEASE=
# Traces OpenTelemetry (OTLP/HTTP) — ex. http://localhost:4318 pour le collecteur de la pile de dev.
# Chargées par `node --import ./dist/instrumentation.js` (script `start`, Dockerfile).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=thy-backend
