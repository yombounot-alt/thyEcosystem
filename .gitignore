# Dependencies
node_modules/
.pnpm-store/
.dart_tool/
.pub-cache/
.pub/
build/
**/ios/Pods/
**/ios/.symlinks/
**/android/.gradle/

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/keys/**/*.pub

# Build outputs
dist/
out/
*.tsbuildinfo
**/coverage/
*.log

# Flutter/Dart generated
**/*.g.dart
**/*.freezed.dart
**/*.gr.dart
**/ios/Flutter/Generated.xcconfig
**/ios/Runner/GeneratedPluginRegistrant.*
**/android/local.properties
**/*.iml

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
backend.hcl
# Contient des mots de passe (voir infra/terraform/templates/bootstrap-roles.sql.tpl)
bootstrap-roles.rendered.sql

# Turborepo
.turbo/

# Misc
*.local

# Fichiers téléversés en développement/tests
uploads/
uploads-test/

# Sorties du générateur de tokens de design (shared/design-tokens/build.mjs) : VERSIONNÉES, car la CI
# vérifie qu'elles sont à jour (`build.mjs --check`) et l'app en a besoin pour compiler.
!mobile/packages/thy_design_system/lib/src/theme/thy_tokens.g.dart
!shared/design-tokens/build/

# Généré par Flutter à chaque `pub get` (chemins absolus du poste) — ne se versionne pas.
.flutter-plugins
.flutter-plugins-dependencies
# Paquets Dart internes (bibliothèques) : c'est l'app qui fige les versions (mobile/app/pubspec.lock).
mobile/packages/*/pubspec.lock
